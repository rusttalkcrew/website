# Container config: plain HTTP on :8080. TLS is terminated by the host's Caddy.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	file_server
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@img path /img/* /favicon.svg
	header @img Cache-Control "public, max-age=86400"
}
